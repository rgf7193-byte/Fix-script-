local function ExecutarTeleguiadoLennon()
    if not _G.AutoFarmAtivo or tick() < _G.CooldownFarm then return end
    
    if type(_G.AtuaisModelos) == "function" then
        _G.AtuaisModelos()
    end

    local ListaAlvos = _G.LennonEggsList or {}
    local melhorAlvoUid = nil
    local maiorGencash = -1
    local posicaoAlvo = nil

    -- Verifica se o usuário possui pelo menos um bicho ativamente marcado
    local possuiMarcacao = false
    for uid, marcado in pairs(_G.BichosSelecionados) do
        if marcado then possuiMarcacao = true break end
    end

    -- Varre os ovos aplicando o filtro inteligente com precisão associativa
    for uid, bicho in pairs(ListaAlvos) do
        if not possuiMarcacao or _G.BichosSelecionados[uid] then
            if bicho.Generation > maiorGencash then
                maiorGencash = bicho.Generation
                melhorAlvoUid = bicho.Uid
                posicaoAlvo = bicho.Position
            end
        end
    end

    -- Se encontrar o alvo exato válido, inicia o voo físico
    if melhorAlvoUid and posicaoAlvo then
        local player = game.Players.LocalPlayer
        local character = player.Character
        local meuHrp = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local playerGui = player:FindFirstChildOfClass("PlayerGui")

        if meuHrp and humanoid and playerGui then
            -- Cria a força de velocidade corporal para ir até o ovo (Velocidade 300)
            local bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            bv.Parent = meuHrp

            local destinoOvo = posicaoAlvo + Vector3.new(0, 2, 0)
            
            -- Loop de aproximação física
            while _G.AutoFarmAtivo and (destinoOvo - meuHrp.Position).Magnitude > 3 do
                local direcao = (destinoOvo - meuHrp.Position).Unit
                bv.Velocity = direcao * 300
                task.wait()
            end

            -- Remove a força física imediatamente após alcançar o ovo
            bv:Destroy()
            meuHrp.AssemblyLinearVelocity = Vector3.zero

            -- =========================================================================
            -- MODIFICAÇÃO CHAVE: PAUSA DE 0.40 SEGUNDOS PARA SINCRONIZAÇÃO DO OVO
            -- =========================================================================
            task.wait(0.40)

            -- Garante que o farm ainda está ativo e que o ovo ainda existe após a pausa
            if _G.AutoFarmAtivo then
                local ovoID = melhorAlvoUid
                if not _G.ActiveSteals then _G.ActiveSteals = {} end
                _G.ActiveSteals[ovoID] = true

                -- Dispara o Remote para carregar EXATAMENTE o ovo selecionado no servidor
                local carryRemote = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Networking"):WaitForChild("RF/EggWorld/AskFieldEggCarry", 5)
                if carryRemote then
                    pcall(function() carryRemote:InvokeServer({ Uid = ovoID }) end)
                end

                -- Executa a movimentação da Parte 4 se ela estiver presente
                if type(_G.ProcessarTrajetoCompletoLennon) == "function" then
                    _G.ProcessarTrajetoCompletoLennon(ovoID, meuHrp, humanoid, playerGui, player, character)
                else
                    _G.ActiveSteals[ovoID] = false
                    _G.CooldownFarm = tick() + 0.3
                end
            end
        end
    else
        -- Se não houver nenhum ovo ou nenhum dos marcados estiver no mapa, aguarda um instante
        task.wait(0.5)
    end
end

